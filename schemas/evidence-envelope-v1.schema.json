{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/evidence-envelope-v1.schema.json",
  "title": "AGENTROPOLIS EvidenceEnvelope v1",
  "type": "object",
  "required": ["id", "source", "provenance", "state", "evidence", "authority"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "feed": { "type": "string" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["retrievedAt", "collector"],
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "collector": { "type": "string", "minLength": 1 },
        "rawHash": { "type": "string" }
      },
      "additionalProperties": true
    },
    "state": {
      "type": "string",
      "enum": ["LIVE", "STALE", "ERR", "OFF"]
    },
    "geography": {
      "type": "object",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "h3": { "type": "string" },
        "geometry": { "type": "object" }
      },
      "additionalProperties": true
    },
    "evidence": {},
    "authority": {
      "type": "object",
      "required": ["class", "executable"],
      "properties": {
        "class": { "const": "OBSERVATION" },
        "executable": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
