{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/spatial-observation.schema.json",
  "title": "SpatialObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observationId",
    "entityId",
    "entityKind",
    "coordinate",
    "properties",
    "provenance",
    "jurisdictionIds",
    "evidenceOnly"
  ],
  "properties": {
    "observationId": { "type": "string", "minLength": 1 },
    "entityId": { "type": "string", "minLength": 1 },
    "entityKind": {
      "type": "string",
      "enum": [
        "satellite",
        "aircraft",
        "vessel",
        "vehicle",
        "infrastructure",
        "camera",
        "weather",
        "fire",
        "earthquake",
        "launch",
        "jurisdiction",
        "site",
        "other"
      ]
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitudeMeters": { "type": "number" }
      }
    },
    "headingDegrees": { "type": "number", "minimum": 0, "maximum": 360 },
    "speedMps": { "type": "number", "minimum": 0 },
    "properties": { "type": "object" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceName",
        "observedAt",
        "receivedAt",
        "sourceState",
        "confidence"
      ],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceName": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "sourceState": {
          "type": "string",
          "enum": ["live", "degraded", "stale", "unavailable"]
        },
        "license": { "type": "string" },
        "attribution": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "confidence": {
          "type": "string",
          "enum": ["verified", "high", "medium", "low", "unknown"]
        }
      }
    },
    "jurisdictionIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "evidenceOnly": { "const": true }
  }
}
